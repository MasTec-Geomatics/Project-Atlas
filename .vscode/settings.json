{
    // ============================================================
    // GIT & VERSION CONTROL / JUJUTSU
    // ============================================================
    "git.enabled": false,

    // ============================================================
    // Local MyPy settings
    // ============================================================
    "mypy-type-checker.cwd": "${workspaceFolder}/api",
    "mypy-type-checker.importStrategy": "fromEnvironment",

    // ============================================================
    // Code spell checker
    // ============================================================
    "cSpell.words": [
        "basemap",
        "Basemaps",
        "EPSG",
        "NOAA",
        "postgis",
        "Procore",
        "Regrid",
        "SRID",
        "structlog",
        "timestamptz",
        "USGS",
        "Uvicorn",
        "Vuetify"
    ],
    "python.terminal.useEnvFile": true,
}

# API database connection. The user, password, and database name must match
# deploy/local/postgis-secret.yaml. Use a password without URL-special characters
# (for example, from `openssl rand -hex 24`).
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:change-me@localhost:5432/atlas
REFERENCE_DATABASE_URL=postgresql+psycopg://atlas:change-me@localhost:5432/reference

# Where the API listens.
API_HOST=127.0.0.1
API_PORT=8000

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
LOG_JSON=false

# Environment
NODE_ENV=development
APP_ENV=development

# API database connection. The user, password, and database name must match
# deploy/local/postgis-secret.yaml. Use a password without URL-special characters
# (for example, from `openssl rand -hex 24`).
DATABASE_URL=postgresql+psycopg://atlas:change-me@localhost:5432/atlas
REFERENCE_DATABASE_URL=postgresql+psycopg://atlas:change-me@localhost:5432/reference

# Folder on real disk where reference loads download and unzip source files (not /tmp,
# which is RAM-backed on many Linux systems). Each load deletes its files when it ends.
# Needs about 10 GB free during a Texas wetlands load. Use a full path; ~ is not expanded.
REFERENCE_WORK_DIR=/home/your-user/.cache/atlas-reference

# Where the API listens.
API_HOST=127.0.0.1
API_PORT=8000

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
LOG_JSON=false
